APP_NAME=TrustVault
ENVIRONMENT=development
DATABASE_URL=sqlite:///./trustvault.db
# Set a long, random secret in every real deployment. Do not commit it.
AUDIT_HMAC_KEY=replace-with-a-long-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=10
STORAGE_DIR=./private_uploads
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-local-development-password
